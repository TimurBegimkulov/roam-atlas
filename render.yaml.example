# Free web service with external PostgreSQL storage. No paid disk.
# Configure DATABASE_URL from your database provider before deployment.
services:
  - type: web
    name: roam-atlas
    runtime: python
    plan: free
    buildCommand: pip install -r requirements.txt
    startCommand: gunicorn --bind 0.0.0.0:$PORT --workers 2 --threads 4 app:application
    healthCheckPath: /api/health
    envVars:
      - key: DATABASE_URL
        sync: false
      - key: ADMIN_USERNAME
        value: admin
      - key: ADMIN_PASSWORD_HASH
        sync: false
      - key: SITE_URL
        sync: false
