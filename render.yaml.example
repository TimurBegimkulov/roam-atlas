# Review Render's current paid plan and disk pricing before provisioning.
# Copy to render.yaml only after choosing and approving the hosting plan.
services:
  - type: web
    name: roam-atlas
    runtime: python
    plan: starter
    buildCommand: pip install -r requirements.txt
    startCommand: gunicorn --bind 0.0.0.0:$PORT --workers 2 --threads 4 app:application
    healthCheckPath: /api/health
    envVars:
      - key: DATABASE_PATH
        value: /var/data/roam-atlas.sqlite3
      - key: SITE_URL
        sync: false
    disk:
      name: roam-atlas-data
      mountPath: /var/data
      sizeGB: 1
