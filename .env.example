# Actual public HTTPS origin, assigned by your hosting provider after deployment.
# Do not use localhost or an invented domain here.
SITE_URL=
# Value from Search Console's HTML meta tag verification method (optional).
GOOGLE_SITE_VERIFICATION=
# Production: private PostgreSQL connection string from Neon, stored only in hosting settings.
DATABASE_URL=
# Local development only; no paid disk is required.
DATABASE_PATH=data/orbit.sqlite3

ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
